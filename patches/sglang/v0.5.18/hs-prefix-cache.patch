@@ -0,0 +1,198 @@
+"""Batch sink completion, atomic reservations and explicit publication transfer."""
+import importlib.util
+import pathlib
+import sys
+import types
+import unittest
+from concurrent.futures import Future
+
+FILE = pathlib.Path(__file__).resolve().parents[3] / 'python/sglang/srt/spec_feature_bridge.py'
+spec = importlib.util.spec_from_file_location('sglang_bridge_transfer_test', FILE)
+bridge = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = bridge
+spec.loader.exec_module(bridge)
+
+
+class PublicationTests(unittest.TestCase):
+    def owner(self):
+        owner = object.__new__(bridge.SpecFeatureBridge)
+        owner.writer, owner.controller, owner.cache = True, None, None
+        owner.epoch, owner.namespace, owner.signature = 'epoch', 'namespace', 'signature'
+        owner.s = types.SimpleNamespace(ps=types.SimpleNamespace(tp_size=1))
+        owner.registry = bridge.AttemptRegistry('epoch', 4)
+        owner.jobs, owner.batches, owner.history = {}, [], []
+        return owner
+
+    def pending(self, owner, index, *, immutable=False):
+        body = dict(store_id='s', sample_id=str(index), gen=1, attempt_id=str(index), request_digest='d')
+        if immutable:
+            body['publication_ownership'] = 'attempt-v1'
+        entry = owner.registry.begin(body, 'token' + str(index))
+        capture = dict(**body, server_epoch='epoch', reservation_token=entry.token,
+                       features=dict(aux='hidden', last_hidden='target'), passthrough=[])
+        if immutable:
+            capture['object_key_layout'] = 'attempt-v1'
+        req = types.SimpleNamespace(rid=str(index), spec_feature_attempt=entry, spec_capture=capture,
+                                    spec_feature_execution_epoch=0)
+        entry.request = req
+        return (req, capture, object(), object(), False, 0.)
+
+    def test_single_sink_batch_distributes_scalar_results_in_order(self):
+        owner = self.owner()
+        submitted = []
+        future = Future()
+        def submit(items):
+            submitted.append(items)
+            return future
+        completed = owner.queue_captures([self.pending(owner, i) for i in range(3)], types.SimpleNamespace(submit_samples=submit))
+        self.assertEqual([len(items) for items in submitted], [3])
+        self.assertFalse(completed.done())
+        future.set_result([dict(value=i) for i in range(3)])
+        owner.poll()
+        self.assertEqual([row['value'] for row in completed.result()], [0, 1, 2])
+        self.assertFalse(owner.jobs)
+
+    def test_batch_count_mismatch_fails_every_child_and_drains(self):
+        owner = self.owner()
+        future = Future()
+        completed = owner.queue_captures([self.pending(owner, i) for i in range(2)], types.SimpleNamespace(submit_samples=lambda items: future))
+        future.set_result([{}])
+        owner.poll()
+        with self.assertRaisesRegex(RuntimeError, 'count mismatch'):
+            completed.result()
+        self.assertFalse(owner.jobs)
+        self.assertTrue(all(entry.state == 'WRITER_DRAINED' for entry in owner.registry.active.values()))
+
+    def test_transfer_certificate_after_release_and_retired_resolution(self):
+        owner = self.owner()
+        pending = self.pending(owner, 0, immutable=True)
+        req, entry = pending[0], pending[0].spec_feature_attempt
+        keys = {name: f's/0/g1/attempt/epoch/{entry.token}/{name}' for name in ('hidden', 'target')}
+        result = dict(features={name: dict(key=key) for name, key in keys.items()})
+        future = Future()
+        completed = owner.queue_captures([pending], types.SimpleNamespace(submit_samples=lambda items: future))
+        released = []
+        owner.jobs[('0', 0)]['sample'] = types.SimpleNamespace(release=lambda: released.append(True), timings={})
+        future.set_result([result])
+        owner.poll()
+        self.assertTrue(released)
+        wire = completed.result()[0]
+        self.assertEqual(wire['state'], 'PUBLISHED')
+        self.assertEqual(wire['publication_ownership'], 'attempt-v1')
+        self.assertEqual(wire['physical_keys'], keys)
+        self.assertFalse(owner.registry.active)
+        # A lost /generate reply can recover the historical publication proof.
+        resolved = owner.control(dict(req.spec_capture, protocol_version=1, action='resolve', cancel=True))
+        self.assertEqual(resolved['state'], 'RETIRED')
+        self.assertEqual(resolved['publication_certificate']['state'], 'PUBLISHED')
+        self.assertEqual(resolved['physical_keys'], keys)
+
+    def test_begin_batch_failure_has_no_partial_reservations(self):
+        owner = self.owner()
+        body = dict(store_id='s', sample_id='0', gen=1, attempt_id='a', request_digest='d')
+        invalid = dict(body, sample_id='1', attempt_id='')
+        with self.assertRaises(ValueError):
+            owner.registry.begin_batch([body, invalid], ['t0', 't1'])
+        self.assertEqual(owner.registry.active, {})
+        self.assertEqual(owner.registry.sequence, 0)
+        with self.assertRaises(ValueError):
+            owner.registry.begin_batch([body, body], ['t0', 't1'])
+        self.assertEqual(owner.registry.active, {})
+
+    def test_evicted_tombstone_fails_closed(self):
+        owner = self.owner()
+        owner.registry = bridge.AttemptRegistry('epoch', 1)
+        body = dict(store_id='s', sample_id='old', gen=1, attempt_id='a', request_digest='d')
+        old = owner.registry.begin(body, 'old')
+        old.state = 'PUBLISHED'
+        owner.registry.retire(old)
+        new = owner.registry.begin(dict(body, sample_id='new'), 'new')
+        new.state = 'PUBLISHED'
+        owner.registry.retire(new)
+        with self.assertRaisesRegex(ValueError, 'unknown'):
+            owner.control(dict(body, protocol_version=1, server_epoch='epoch', reservation_token='old', action='resolve'))
+
+
+if __name__ == '__main__':
+    unittest.main()
+
+class UncertainPublicationTests(PublicationTests):
+    def test_unknown_native_writer_retains_sample_and_fence(self):
+        owner = self.owner()
+        pending = self.pending(owner, 0, immutable=True)
+        future = Future()
+        completed = owner.queue_captures([pending], types.SimpleNamespace(submit_samples=lambda items: future))
+        released = []
+        owner.jobs[('0', 0)]['sample'] = types.SimpleNamespace(release=lambda: released.append(True), timings={})
+        error = RuntimeError('native timeout')
+        error.capture_writer_drained = False
+        future.set_exception(error)
+        owner.poll()
+        with self.assertRaises(RuntimeError):
+            completed.result()
+        self.assertFalse(released)
+        entry = pending[0].spec_feature_attempt
+        self.assertEqual(entry.state, 'DRAINING')
+        self.assertTrue(entry.drains)
+        self.assertFalse(entry.drains[-1].done())
+        self.assertEqual(len(owner.quarantined_publications), 1)
+        self.assertFalse(entry.transfer_certificate)
+        with self.assertRaisesRegex(ValueError, 'drain unknown'):
+            owner.control(dict(protocol_version=1, server_epoch='epoch', action='begin'))
+
+
+class NativeSinkUncertaintyTests(unittest.TestCase):
+    def test_transfer_fail_retains_native_registration_and_source(self):
+        import os
+        import torch
+        from unittest import mock
+        sink_file = FILE.with_name('spec_capture_sink.py')
+        module_spec = importlib.util.spec_from_file_location('sglang_sink_transfer_test', sink_file)
+        module = importlib.util.module_from_spec(module_spec)
+        module_spec.loader.exec_module(module)
+        events = []
+        backend = types.SimpleNamespace(register_buffer=lambda ptr, size: events.append('register') or 0,
+            unregister_buffer=lambda ptr: events.append('unregister'),
+            batch_put_from=lambda *args: [-800], remove=lambda key: events.append('remove'))
+        sink = module.SpecCaptureSink()
+        sink._store = backend
+        spec = dict(store_id='s', sample_id='sample', gen=1, server_epoch='epoch', reservation_token='token',
+                    object_key_layout='attempt-v1', features=dict(aux='hidden'))
+        with mock.patch.dict(os.environ, {'MOONCAKE_PROTOCOL': 'tcp', 'SGLANG_SPEC_CAPTURE_GPU_PUT': '0'}):
+            with self.assertRaises(module.CaptureWriterUncertain):
+                sink.put_samples([(spec, torch.ones(2, 2), None)])
+        self.assertEqual(events, ['register'])
+        self.assertEqual(len(sink._uncertain_publications), 1)
+        self.assertEqual(sink._uncertain_publications[0]['keys'], ['s/sample/g1/attempt/epoch/token/hidden'])
+        self.assertTrue(sink._uncertain_publications[0]['tensors'])
+        sink._executor.shutdown()
+
+class FatalAgreementTests(unittest.TestCase):
+    def test_late_reserved_claim_is_symmetric_and_new_begin_rejected_on_both_ranks(self):
+        fixture = PublicationTests()
+        writer, follower = fixture.owner(), fixture.owner()
+        follower.writer = False
+        writer.enabled = follower.enabled = False
+        late = [fixture.pending(owner, 0, immutable=True) for owner in (writer, follower)]
+        writer.fatal_capture_error = 'native writer drain unknown'
+        for owner, pending in zip((writer, follower), late):
+            req = pending[0]
+            req.spec_capture.update(protocol_version=1, capture_namespace='namespace', capture_signature='signature')
+            req.origin_input_ids = [1, 2]
+            req.spec_feature_attempt.request_digest = bridge.digest_request(req.origin_input_ids, req.spec_capture)
+            req.sampling_params = types.SimpleNamespace(max_new_tokens=0)
+            for name in ('multimodal_inputs', 'session', 'lora_id', 'positional_embed_overrides', 'cache_salt', 'session_id'):
+                setattr(req, name, None)
+            owner.claim(req)  # Even writer-only fatal must not split these claims.
+            self.assertTrue(req.spec_feature_attempt.claimed)
+        calls = []
+        completed = writer.queue_captures([late[0]], types.SimpleNamespace(submit_samples=lambda items: calls.append(items)))
+        with self.assertRaisesRegex(RuntimeError, 'drain unknown'):
+            completed.result()
+        self.assertFalse(calls)
+        follower.broadcast = lambda value: ([], writer.fatal_capture_error)
+        body = dict(action='begin', protocol_version=1, server_epoch='epoch')
+        for owner in (writer, follower):
+            with self.assertRaisesRegex(ValueError, 'drain unknown'):
+                owner.control(body)
+        self.assertEqual(writer.fatal_capture_error, follower.fatal_capture_error)
diff --git a/test/registered/spec_feature_bridge/test_runtime_integration.py b/test/registered/spec_feature_bridge/test_runtime_integration.py
