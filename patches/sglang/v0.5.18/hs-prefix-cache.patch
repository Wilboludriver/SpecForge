+            self.owner.snapshot(types.SimpleNamespace(reqs=[req]),types.SimpleNamespace(logits_output=types.SimpleNamespace(hidden_states=data['aux'],last_hidden_states=data['last_hidden'])))
+            retained=[]
+            def sink(items):
+                spec,aux,last=items[0]
+                self.assertTrue(torch.equal(aux,original['aux']))
