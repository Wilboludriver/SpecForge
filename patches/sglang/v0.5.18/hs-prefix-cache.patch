+            req.spec_feature_limit = L
+            req.spec_feature_scalar_plan = {"plan_digest": plan_digest, "issue_sequence": entry.sequence, "H": H, "L": L, "N": N, "span": [L, N],
+                                            "execution_epoch": execution.execution_epoch,
+                                            "rank": self.s.ps.tp_rank}
+            entry.last_plan = req.spec_feature_scalar_plan
+            entry.state = "ADMITTED"
+            self.history.append(dict(entry.last_plan, request_id=req.rid, attempt_id=entry.attempt_id))
+            journal.commit()
+            committed = True
+            return AddReqResult[result.name] if len({x[2] for x in votes}) == 1 else AddReqResult.OTHER
+        finally:
+            if not committed:
+                if journal is not None:
+                    journal.rollback()
+                self._rollback_match(req, before)
+                if self.writer:
+                    if lease is not None:
+                        self.cache.release_lease(lease)
+                    if reservation is not None:
+                        self.controller.release_output(reservation)
+
+    def snapshot(self, batch, result):
+        if not self.writer:
+            return
+        for req in batch.reqs:
+            entry = getattr(req, "spec_feature_attempt", None)
+            if entry is not None:
+                req.spec_feature_forward_events = getattr(result, "spec_feature_forward_events", None)
+                if not self.enabled:
+                    N = len(req.origin_input_ids)
+                    entry.last_plan = {"H": 0, "L": 0, "N": N, "span": [0, N],
+                                       "execution_epoch": req.spec_feature_execution_epoch, "rank": self.s.ps.tp_rank}
+                    self.history.append(dict(entry.last_plan, request_id=req.rid, attempt_id=entry.attempt_id))
+        if not self.enabled:
+            return
+        import torch
+        from sglang.srt.spec_feature_cache import CapturedSpan
+        offset = 0
+        for req in batch.reqs:
+            count = req.extend_range.length if req.extend_range is not None else 0
+            plan = getattr(req, "spec_feature_plan", None)
+            if plan is not None:
+                entry = req.spec_feature_attempt
+                if not entry.revoked:
+                    features = {}
+                    used_cuda = False
+                    try:
+                        for artifact, field_name in (("aux", "hidden_states"), ("last_hidden", "last_hidden_states")):
