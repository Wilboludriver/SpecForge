+++ b/test/registered/spec_feature_bridge/test_runtime_integration.py
@@ -0,0 +1,144 @@
+"""Engine bridge transactions against the actual PrefixFeatureCache/controller."""
+import importlib.util
+import os
+import pathlib
+import sys
+import time
+import types
+import unittest
+from concurrent.futures import Future
+from enum import Enum, auto
+from unittest import mock
+
+import torch
+
+# Dependency source can be A's read-only worktree before root integration.
+if os.environ.get('SGLANG_FEATURE_CACHE_SOURCE'):
+    sys.path.insert(0, os.environ['SGLANG_FEATURE_CACHE_SOURCE'])
+from sglang.srt.spec_feature_cache import FeatureSpec, FeatureSchema, PrefixFeatureCache, CaptureController
+
+FILE = pathlib.Path(__file__).resolve().parents[3] / 'python/sglang/srt/spec_feature_bridge.py'
+spec = importlib.util.spec_from_file_location('sglang_bridge_runtime_test', FILE)
+bridge = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = bridge
+spec.loader.exec_module(bridge)
+
+class Result(Enum):
+    CONTINUE = auto()
+    OTHER = auto()
+    NO_TOKEN = auto()
+
+
+class RuntimeTests(unittest.TestCase):
+    def setUp(self):
+        schema = FeatureSchema((FeatureSpec('aux', 4, 'float32', (1,)), FeatureSpec('last_hidden', 2, 'float32', ())))
+        self.cache = PrefixFeatureCache(schema,4,4096)
+        self.controller = CaptureController(self.cache,schema,4096,4096,4096)
+        self.released=[]
+        self.kv=types.SimpleNamespace(dec_lock_ref=lambda *a:self.released.append(a),
+            req_to_token_pool=types.SimpleNamespace(mamba_allocator=types.SimpleNamespace(free=lambda x:self.released.append(('mamba',x)))))
+        self.owner=bridge.SpecFeatureBridge.__new__(bridge.SpecFeatureBridge)
+        self.owner.s=types.SimpleNamespace(ps=types.SimpleNamespace(tp_rank=0),tree_cache=self.kv)
+        self.owner.writer=True;self.owner.enabled=True;self.owner.epoch='epoch';self.owner.namespace='namespace';self.owner.signature='signature'
+        self.owner.cache=self.cache;self.owner.controller=self.controller
+        self.owner.registry=bridge.AttemptRegistry('epoch',32)
+        self.owner.history=[];self.owner.jobs={};self.owner.batches=[]
+        self.owner.broadcast=lambda value:value
+        self.owner.gather=lambda value:[value]
+        self.addCleanup(self.owner.shutdown)
+        self.policy=mock.patch.dict(sys.modules,{'sglang.srt.managers.schedule_policy':types.SimpleNamespace(AddReqResult=Result)})
+        self.policy.start();self.addCleanup(self.policy.stop)
+
+    def request(self,rid='r'):
+        entry=self.owner.registry.begin(dict(store_id='s',sample_id=rid,gen=1,attempt_id=rid,request_digest='digest'))
+        req=types.SimpleNamespace(rid=rid,origin_input_ids=list(range(8)),spec_feature_attempt=entry,
+            spec_feature_bridge=self.owner,spec_feature_execution_epoch=0,spec_feature_limit=0,
+            spec_capture=dict(features={'aux':'hidden_state','last_hidden':'target'},passthrough=[]),
+            prefix_indices=torch.empty(0,dtype=torch.int64),last_node='root',mamba_pool_idx=None,
+            mamba_cow_src_index=None,mamba_needs_clear=False,extend_range=None)
+        def match(tree):
