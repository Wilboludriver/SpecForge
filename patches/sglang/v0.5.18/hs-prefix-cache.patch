+"""Reject measured non-invariant HS reuse before expensive model initialization."""
+
+import unittest
+from unittest import mock
+
+from sglang.srt.server_args import ServerArgs
+
+
+class NumericalModeArgsTests(unittest.TestCase):
+    def test_reuse_rejects_non_invariant_mode_before_resolution(self):
+        with mock.patch.object(ServerArgs, "_run_resolution_pipeline") as resolve:
+            with self.assertRaisesRegex(ValueError, "requires --enable-deterministic-inference"):
+                ServerArgs(model_path="fixture", enable_spec_capture=True, spec_feature_cache=True)
+            resolve.assert_not_called()
+
+    def test_reuse_accepts_explicit_batch_invariant_mode(self):
+        with mock.patch.object(ServerArgs, "_run_resolution_pipeline") as resolve:
+            args = ServerArgs(model_path="fixture", enable_spec_capture=True,
+                              spec_feature_cache=True, enable_deterministic_inference=True)
+            self.assertTrue(args.enable_deterministic_inference)
+            resolve.assert_called_once_with()
+
+    def test_legacy_cache_off_preserves_original_execution_choice(self):
+        with mock.patch.object(ServerArgs, "_run_resolution_pipeline") as resolve:
+            args = ServerArgs(model_path="fixture", enable_spec_capture=True)
+            self.assertFalse(args.spec_feature_cache)
+            self.assertFalse(args.enable_deterministic_inference)
+            resolve.assert_called_once_with()
+
+    def test_incompatible_checkpoint_modes_fail_before_model_resolution(self):
+        for name in ("enable_int8_mamba_checkpoint", "enable_mamba_cache_stochastic_rounding",
+                     "enable_linear_replayssm", "enable_linear_replayssm_spec"):
+            with self.subTest(option=name), mock.patch.object(ServerArgs, "_run_resolution_pipeline") as resolve:
+                with self.assertRaisesRegex(ValueError, "uncompressed exact recurrent checkpoints"):
+                    ServerArgs(model_path="fixture", enable_spec_capture=True,
+                               spec_feature_cache=True, enable_deterministic_inference=True,
+                               **{name: True})
+                resolve.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
