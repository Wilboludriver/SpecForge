@@ -0,0 +1,72 @@
+"""Real hybrid finalizer exceptions must not retain temporary checkpoint locks."""
+
+import unittest
+from types import SimpleNamespace
+
+import torch
+
+from sglang.srt.mem_cache.unified_cache.components.mamba_component import MambaComponent
+from sglang.srt.spec_feature_bridge import SpecFeatureBridge
+
+
+class MatchRollbackTests(unittest.TestCase):
+    def test_temporary_lock_unwinds_and_fresh_cow_slot_rolls_back(self):
+        for mode in ("evict-error", "alloc-error", "alloc-none", "success"):
+            with self.subTest(mode=mode):
+                receipt = object()
+                state = SimpleNamespace(calls=0, locks=0, freed=[])
+
+                def alloc(count):
+                    self.assertEqual(count, 1)
+                    state.calls += 1
+                    if state.calls == 1 or mode == "alloc-none":
+                        return None
+                    if mode == "alloc-error":
+                        raise RuntimeError("injected allocation failure")
+                    return torch.tensor([7])
+
+                def evict(params):
+                    if mode == "evict-error":
+                        raise RuntimeError("injected eviction failure")
+
+                def inc(node):
+                    state.locks += 1
+                    return SimpleNamespace(to_dec_params=lambda: receipt)
+
+                def dec(node, params):
+                    self.assertIs(params, receipt)
+                    state.locks -= 1
+
+                allocator = SimpleNamespace(alloc=alloc, free=state.freed.append)
+                cache = SimpleNamespace(
+                    req_to_token_pool=SimpleNamespace(mamba_allocator=allocator),
+                    inc_lock_ref=inc, dec_lock_ref=dec, evict=evict,
+                )
+                component = object.__new__(MambaComponent)
+                component.cache = cache
+                component.tree_core = SimpleNamespace(
+                    get_component_device_value=lambda node, kind: torch.tensor([3])
+                )
+                request = SimpleNamespace(
+                    mamba_pool_idx=None, mamba_cow_src_index=None, mamba_needs_clear=False
+                )
+                before = dict(vars(request))
+                result = SimpleNamespace(best_match_node="checkpoint")
+                params = SimpleNamespace(cow_mamba=True, req=request)
+                if mode == "success":
+                    self.assertIs(component.finalize_match_result_in_cache(params, result), result)
+                else:
+                    with self.assertRaises((RuntimeError, AssertionError)):
+                        component.finalize_match_result_in_cache(params, result)
+                owner = object.__new__(SpecFeatureBridge)
+                owner.s = SimpleNamespace(tree_cache=cache)
+                owner._rollback_match(request, before)
+                self.assertEqual(state.locks, 0)
+                self.assertEqual(vars(request), before)
+                self.assertEqual(len(state.freed), int(mode == "success"))
+                if state.freed:
+                    self.assertEqual(state.freed[0].tolist(), [7])
+
+
+if __name__ == "__main__":
+    unittest.main()
