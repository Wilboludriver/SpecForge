+                                raise RuntimeError("capture source/span mismatch")
+                            used_cuda = used_cuda or source.is_cuda
+                            view = source[offset:offset + count]
+                            features[artifact] = view.detach().clone()
+                            if source.is_cuda:
+                                source.record_stream(torch.cuda.current_stream(source.device))
+                        ready = None
+                        if any(t.is_cuda for t in features.values()):
+                            ready = torch.cuda.Event()
