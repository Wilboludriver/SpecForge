+            kwargs.pop("pin_memory", None)
+            return real_empty(*args, **kwargs)
+        with mock.patch("torch.empty", allocate):
+            a = self.controller._staging_views(8, first)
+            b = self.controller._staging_views(8, second)
+            for value in a.values():
