+"""Real CUDA regression: recurrent checkpoint precision, unchanged BF16 math.
+
+Run directly with one explicitly allocated visible GPU. This is a kernel-level
+proof; full target/draft numerical acceptance remains a separate model test.
+"""
+import json
+import unittest
+from unittest import mock
+
+import torch
+
+from sglang.kernels.ops.attention.fla.chunk import chunk_gated_delta_rule
+
+
+class CheckpointDispatchTest(unittest.TestCase):
+    def test_default_does_not_extend_legacy_backend_signature(self):
+        import importlib
+        module = importlib.import_module("sglang.kernels.ops.attention.fla.chunk")
+        value = torch.zeros((1, 1, 1, 1), dtype=torch.bfloat16)
+        # The fixed XPU override has no preserve_checkpoint_precision keyword.
+        def legacy_h(*, k, w, u, g, initial_state, initial_state_indices,
+                     cu_seqlens, chunk_indices):
+            return value, value
+        with mock.patch.object(module, 'chunk_local_cumsum', return_value=value), \
+             mock.patch.object(module, 'chunk_gated_delta_rule_fwd_intra', return_value=(value, value, value)), \
+             mock.patch.object(module, 'chunk_gated_delta_rule_fwd_h', side_effect=legacy_h) as state, \
+             mock.patch.object(module, 'chunk_fwd_o', return_value=value):
+            module.chunk_gated_delta_rule_fwd(value, value, value, value, value, 1., value, None)
+        state.assert_called_once()
+        self.assertNotIn('preserve_checkpoint_precision', state.call_args.kwargs)
+
+
+@unittest.skipUnless(torch.cuda.is_available(), "explicit CUDA allocation required")
+class CheckpointPrecisionTest(unittest.TestCase):
+    def test_real_hybrid_shapes_and_checkpoint_continuation(self):
+        records = []
+        rounded_mismatches = 0
+        for tp in (1, 2):
+            hq, hv, dimension = 16 // tp, 32 // tp, 128
+            for length, prefix in ((768, 512), (257, 256), (511, 256), (512, 448), (1024, 960)):
+                torch.manual_seed(1234 + length)
+                q = torch.randn((1, length, hq, dimension), device="cuda", dtype=torch.bfloat16)
+                k = torch.randn_like(q)
+                v = torch.randn((1, length, hv, dimension), device="cuda", dtype=torch.bfloat16)
+                g = -torch.rand((1, length, hv), device="cuda", dtype=torch.float32) * .1
+                beta = torch.rand((1, length, hv), device="cuda", dtype=torch.float32)
+
+                def evaluate(start, preserve, state=None):
+                    pool = (torch.zeros((1, hv, dimension, dimension), device="cuda", dtype=torch.float32)
+                            if state is None else state.clone().contiguous())
+                    output, _, checkpoints = chunk_gated_delta_rule(
+                        q=q[:, start:].contiguous(), k=k[:, start:].contiguous(),
+                        v=v[:, start:].contiguous(), g=g[:, start:].contiguous(),
+                        beta=beta[:, start:].contiguous(), initial_state=pool,
+                        initial_state_indices=torch.zeros(1, device="cuda", dtype=torch.int32),
+                        cu_seqlens=torch.tensor([0, length-start], device="cuda", dtype=torch.int32),
+                        use_qk_l2norm_in_kernel=True,
+                        preserve_checkpoint_precision=preserve,
+                    )
+                    return output, checkpoints, pool
+
+                original, rounded, original_final = evaluate(0, False)
+                precise, exact, precise_final = evaluate(0, True)
+                self.assertEqual(rounded.dtype, torch.bfloat16)
+                self.assertEqual(exact.dtype, torch.float32)
+                self.assertTrue(torch.equal(original, precise), "full-forward BF16 output changed")
+                self.assertTrue(torch.equal(original_final, precise_final), "full-forward recurrent update changed")
+                self.assertTrue(torch.equal(rounded, exact.to(torch.bfloat16)))
+                resumed, _, resumed_final = evaluate(prefix, True, exact[:, prefix//64])
+                lossy, _, _ = evaluate(prefix, True, rounded[:, prefix//64].float())
+                expected = original[:, prefix:]
+                mismatch = int((lossy != expected).sum().item())
+                rounded_mismatches += mismatch
+                self.assertTrue(torch.equal(resumed, expected), "FP32 checkpoint resumed output differs")
+                self.assertTrue(torch.equal(resumed_final, precise_final), "FP32 checkpoint resumed final state differs")
+                records.append({"tp_shape": tp, "N": length, "L": prefix,
+                                "full_output_bitexact": True, "resumed_output_bitexact": True,
+                                "resumed_final_state_bitexact": True,
+                                "bf16_checkpoint_output_mismatches": mismatch})
+        self.assertGreater(rounded_mismatches, 0, "negative control did not expose checkpoint precision loss")
+        print(json.dumps({"passed": True, "cases": records,
+                          "scope": "actual CUDA GDN kernel; selected hybrid TP1/TP2 head shapes"}))
+
+
+if __name__ == "__main__":
+    unittest.main()
