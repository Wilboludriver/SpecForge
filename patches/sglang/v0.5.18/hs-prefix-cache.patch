+            if not all(x[1] for x in votes):
+                return AddReqResult.OTHER
+            plan_error = None
+            if self.writer:
+                try:
+                    req.spec_feature_plan = self.controller.freeze_plan(execution, self.namespace, tokens, N, L, lease, reservation)
+                except Exception as exc:
