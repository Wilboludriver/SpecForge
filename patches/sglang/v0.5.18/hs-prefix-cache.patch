+"""CPU-only adversarial tests of the production Plan A cache/controller."""
+
+import gc
+import threading
+import weakref
+from contextlib import nullcontext
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import replace
+from unittest import mock
+
+import torch
+
+from sglang.srt.spec_feature_cache import (
+    AdmissionBudgetError, CaptureCancelledError, CaptureCompletion,
+    CaptureContractError, CaptureController, CapturedSpan, ExecutionIdentity,
+    FeatureSchema, FeatureSpec, PrefixFeatureCache,
+)
+
+
+def schema():
+    return FeatureSchema((FeatureSpec("aux", 2, "float32", (1, 3)),
+                          FeatureSpec("last_hidden", 2, "float32", ())))
+
+
+def identity(n=0, epoch=0):
+    return ExecutionIdentity("server", f"request-{n}", f"attempt-{n}", epoch)
+
+
+def features(n, start=0):
+    rows = torch.arange(start * 2, (start + n) * 2, dtype=torch.float32).reshape(n, 2)
+    return {"aux": rows.clone(), "last_hidden": (rows + 1000).clone()}
+
+
+def populate(cache, tokens, values=None, namespace="ns"):
+    values = features(len(tokens)) if values is None else values
+    for key in cache.block_keys(namespace, tokens):
+        fill = cache.reserve_fill(key, identity())
+        if fill is not None:
+            cache.publish_ready(fill, {k: v[key.start:key.end] for k, v in values.items()})
+
+
+class GateEvent:
+    def __init__(self):
+        self.entered = threading.Event()
+        self.finished = threading.Event()
+
+    def synchronize(self):
