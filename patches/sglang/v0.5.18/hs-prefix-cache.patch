+    def invalidate(self, entry, reason):
+        if entry.transfer_certificate:
+            return  # Published immutable bytes now belong to the receiver.
+        entry.revoked, entry.state = True, "DRAINING"
+        req = entry.request
+        if req is not None:
+            req.spec_capture_result = {"sample_id": entry.identity[1], "error": reason}
+        if self.writer and self.controller and req is not None:
+            plan = getattr(req, "spec_feature_plan", None)
+            if plan is not None and plan.execution not in getattr(self, "quarantined_executions", set()):
+                entry.drains.append(self.controller.invalidate(plan.execution, reason))
+        self._mark_drained(entry)
+
+    def invalidate_request(self, req, reason, retract=False):
+        entry = getattr(req, "spec_feature_attempt", None)
+        if entry is None or entry.transfer_certificate:
+            return
+        plan = getattr(req, "spec_feature_plan", None)
+        if self.writer and self.controller and plan is not None and plan.execution not in getattr(self, "quarantined_executions", set()):
+            entry.drains.append(self.controller.invalidate(plan.execution, reason))
+        req.spec_feature_plan = None
+        req.spec_feature_limit = 0
+        req.spec_feature_execution_epoch += 1
+        entry.execution_epoch = req.spec_feature_execution_epoch
+        if not retract:
+            entry.revoked, entry.state = True, "DRAINING"
+            req.spec_capture_result = {"sample_id": entry.identity[1], "error": reason}
+        else:
