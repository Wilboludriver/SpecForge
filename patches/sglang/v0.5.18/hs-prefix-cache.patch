+
+    def queue_captures(self, pending, sink):
+        outputs = []
+        for req, spec, aux, hidden, _, _ in pending:
+            entry = getattr(req, "spec_feature_attempt", None)
+            if entry is None:
+                raise RuntimeError("mixed negotiated/legacy capture batch")
+            plan = getattr(req, "spec_feature_plan", None)
+            key = (req.rid, plan.execution.execution_epoch if plan else req.spec_feature_execution_epoch)
+            if plan:
+                job = self.jobs.get(key)
+                if job is None:
+                    raise RuntimeError("capture has no matching execution snapshot")
+            else:
+                job = {"req": req, "entry": entry, "plan": None, "materialize": None,
+                       "sink": None, "sample": None, "output": None, "legacy": (spec, aux, hidden),
+                       "forward_events": getattr(req, "spec_feature_forward_events", None)}
