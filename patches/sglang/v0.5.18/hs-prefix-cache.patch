+class AdmissionJournal:
+    """Reversible nonchunked PrefillAdder mutations, including exact lock receipts."""
+    def __init__(self, adder, req):
+        self.adder, self.req = adder, req
+        self.scalars = {name: value for name, value in vars(adder).items()
+                        if isinstance(value, (int, float, bool, type(None)))}
+        self.lists = {name: list(getattr(adder, name)) for name in ("can_run_list", "preempt_list")}
+        self.request = {name: getattr(req, name, None) for name in
+                        ("extend_range", "skip_lock_node_ids", "swa_uuid_for_lock")}
+        self.receipts = []
+        self.done = False
+        if getattr(adder, "_spec_feature_journal", None) is not None:
+            raise RuntimeError("nested admission transaction")
+        adder._spec_feature_journal = self
+
+    def record_lock(self, node, result):
+        params = result.to_dec_params() if hasattr(result, "to_dec_params") else None
+        self.receipts.append((node, params))
+
+    def commit(self):
+        self.done = True
+        self.adder._spec_feature_journal = None
+
+    def rollback(self):
+        if self.done:
+            return
+        self.done = True
+        self.adder._spec_feature_journal = None
+        for node, params in reversed(self.receipts):
+            if params is None:
+                self.adder.tree_cache.dec_lock_ref(node)
+            else:
+                self.adder.tree_cache.dec_lock_ref(node, params)
+        for name, value in self.scalars.items():
+            setattr(self.adder, name, value)
+        for name, value in self.lists.items():
+            getattr(self.adder, name)[:] = value
+        for name, value in self.request.items():
+            setattr(self.req, name, value)
